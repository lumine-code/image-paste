{
  "name": "image-paste",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Paste clipboard images into projects as image files.",
  "keywords": [
    "clipboard",
    "screenshot",
    "png",
    "insert",
    "upload"
  ],
  "repository": "https://github.com/lumine-code/image-paste",
  "bugs": {
    "url": "https://github.com/lumine-code/image-paste/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "spec",
    "styles"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "configSchema": {
    "assetsDirectory": {
      "title": "Assets Directory",
      "description": "Editor-relative directory used when saving images pasted into text editors.",
      "type": "string",
      "default": "assets"
    },
    "forwardSlash": {
      "title": "Use Forward Slashes",
      "description": "Insert image paths with forward slashes in text editors.",
      "type": "boolean",
      "default": true
    },
    "imagePreview": {
      "title": "Image Preview",
      "description": "Show an image preview in the save dialog.",
      "type": "boolean",
      "default": true
    }
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "tree-view.selection": {
      "versions": {
        "^1.0.0": "consumeTreeViewSelection"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9"
  }
}
